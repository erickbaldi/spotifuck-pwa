    <!-- JAVASCRIPT LOGIC -->
    <script>
        // --- VERSIONE APPLICAZIONE (MINOR RELEASE) ---
        const APP_VERSION = "v3.7.6";

        let serverConfig = {
            url: "https://erick.ns0.it",
            user: localStorage.getItem('pwa_sub_user') || localStorage.getItem('sub_user') || '',
            pass: localStorage.getItem('pwa_sub_pass') || localStorage.getItem('sub_pass') || ''
        };

        let currentPlaylist = [];
        let originalPlaylist = [];
        let currentIndex = 0;
        let showLyricsMode = false;
        let showMetaMode = false;
        let isShuffleActive = false;
        let repeatMode = 0; // 0 = Off, 1 = Repeat All, 2 = Repeat One
        
        let navigationStack = [];
        let currentFolderItems = []; 
        let cachedArtistsItems = null; 
        const audioElement = document.getElementById('audio-element');

        let scrobbleSent = false;
        let scrobbleTimer = null;
        let deferredPrompt = null;
        let currentBlobUrl = null;

        // --- CACHE IN MEMORIA PER PREFETCH TRACCIA SUCCESSIVA ---
        let blobCache = new Map();

        async function prefetchNextTrack() {
            if (currentIndex + 1 < currentPlaylist.length) {
                const nextTrack = currentPlaylist[currentIndex + 1];
                if (nextTrack && !blobCache.has(nextTrack.id)) {
                    try {
                        const response = await fetch(nextTrack.url, { credentials: 'omit' });
                        if (response.ok) {
                            const blob = await response.blob();
                            blobCache.set(nextTrack.id, blob);
                        }
                    } catch (err) {
                        console.log("Prefetch in background saltato (connessione instabile o timeout).");
                    }
                }
            }
        }

        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            deferredPrompt = e;
        });

        window.addEventListener('beforeunload', () => {
            sendPlayerUpdate('stopped', '', 0);
            audioElement.pause();
            audioElement.src = "";
            audioElement.load();
        });

        window.addEventListener('pagehide', () => {
            sendPlayerUpdate('stopped', '', 0);
            audioElement.pause();
            audioElement.src = "";
            audioElement.load();
        });

