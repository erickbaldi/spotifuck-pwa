        async function loadMusicFolders() {
            if (!serverConfig.user || !serverConfig.pass) {
                hideSplashQuickly();
                openSettings();
                setTimeout(showInstallBanner, 1200);
                return;
            }

            cachedArtistsItems = null; 
            navigationStack = [];
            document.getElementById('section-title').innerText = "Libreria Musicale";
            document.getElementById('btn-back-folders').classList.add('hidden');
            document.getElementById('btn-play-album').classList.add('hidden');
            document.getElementById('search-input').value = '';
            
            const headerBtnIcon = document.getElementById('btn-header-starred')?.querySelector('i');
            if (headerBtnIcon) headerBtnIcon.className = 'fa-solid fa-star text-lg text-gray-400 hover:text-amber-400';
            
            updateSearchPlaceholder();

            const grid = document.getElementById('content-grid');
            grid.innerHTML = '<div class="text-gray-500 text-xs text-center py-8"><i class="fa-solid fa-spinner fa-spin mr-1"></i> Connessione in corso...</div>';

            try {
                const auth = getSubsonicAuthParams();
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 60000); 

                const endpoint = `${serverConfig.url}/rest/getMusicFolders?${auth}`;
                const response = await fetch(endpoint, { signal: controller.signal, credentials: 'omit' });
                clearTimeout(timeoutId);

                const data = await response.json();

                if (data['subsonic-response'].status === 'ok') {
                    const folders = data['subsonic-response'].musicFolders?.musicFolder || [];
                    document.getElementById('welcome-banner').style.display = 'none';
                    await loadFolderIndexes(null, "Libreria Musicale", folders);
                } else {
                    document.getElementById('connection-status').innerText = "Errore autenticazione.";
                    hideSplashQuickly();
                    openSettings();
                    setTimeout(showInstallBanner, 1200);
                }
            } catch (err) {
                renderServerError();
                hideSplashQuickly();
                setTimeout(showInstallBanner, 1200);
            }
        }

        async function loadFolderIndexes(folderId, folderName, musicFolders = []) {
            navigationStack.push({ id: folderId, name: folderName, isIndex: true, level: 'artist' });
            updateBackButtonUI();
            updateSearchPlaceholder();
            document.getElementById('section-title').innerText = "Libreria Musicale";
            document.getElementById('btn-play-album').classList.add('hidden');

            const grid = document.getElementById('content-grid');

            if (!folderId && cachedArtistsItems && cachedArtistsItems.length > 0) {
                currentFolderItems = cachedArtistsItems;
                renderFolderContent(cachedArtistsItems, 'artist');
                document.querySelector('main').scrollTop = 0;
                hideSplashQuickly();
                setTimeout(showInstallBanner, 1000);
                return;
            }

            grid.innerHTML = '<div class="text-gray-500 text-xs text-center py-8"><i class="fa-solid fa-spinner fa-spin mr-1"></i> Caricamento lista artisti...</div>';

            try {
                const auth = getSubsonicAuthParams();
                let allItems = [];

                let targetFolderIds = [];
                if (folderId) {
                    targetFolderIds.push(folderId);
                } else if (musicFolders && musicFolders.length > 0) {
                    targetFolderIds = musicFolders.map(f => f.id);
                } else {
                    targetFolderIds = [''];
                }

                for (let fId of targetFolderIds) {
                    const musicFolderParam = fId ? `&musicFolderId=${fId}` : '';
                    const controller = new AbortController();
                    const timeoutId = setTimeout(() => controller.abort(), 60000); 

                    const endpoint = `${serverConfig.url}/rest/getIndexes?${auth}${musicFolderParam}`;
                    const response = await fetch(endpoint, { signal: controller.signal, credentials: 'omit' });
                    clearTimeout(timeoutId);

                    const data = await response.json();

                    if (data['subsonic-response']?.status === 'ok') {
                        const indexData = data['subsonic-response'].indexes;
                        if (!indexData) continue;

                        if (indexData.child) {
                            indexData.child.forEach(item => { item._itemType = 'artist'; allItems.push(item); });
                        }
                        if (indexData.index) {
                            indexData.index.forEach(group => {
                                if (group.artist) {
                                    group.artist.forEach(art => { art._itemType = 'artist'; allItems.push(art); });
                                }
                            });
                        }
                    }
                }

                if (allItems.length === 0 && musicFolders.length > 0) {
                    for (let f of musicFolders) {
                        const controller = new AbortController();
                        const timeoutId = setTimeout(() => controller.abort(), 60000); 
                        const rootResp = await fetch(`${serverConfig.url}/rest/getMusicDirectory?${auth}&id=${f.id}`, { signal: controller.signal, credentials: 'omit' });
                        clearTimeout(timeoutId);
                        
                        const rootData = await rootResp.json();
                        const children = rootData['subsonic-response']?.directory?.child || [];
                        children.forEach(c => { c._itemType = 'artist'; allItems.push(c); });
                    }
                }

                allItems = Array.from(new Map(allItems.map(item => [item.id, item])).values());
                allItems.sort((a, b) => (a.name || a.title || "").localeCompare(b.name || b.title || ""));

                if (!folderId) {
                    cachedArtistsItems = allItems; 
                }

                currentFolderItems = allItems;
                renderFolderContent(allItems, 'artist');
                document.querySelector('main').scrollTop = 0;
            } catch (err) {
                renderServerError();
            } finally {
                hideSplashQuickly();
                setTimeout(showInstallBanner, 1000);
            }
        }

        function loadMusicDirectory(dirId, dirName) {
            executeLoadDirectory(dirId, dirName, true);
        }

        async function executeLoadDirectory(dirId, dirName, pushToStack = true) {
            try {
                const auth = getSubsonicAuthParams();
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 60000); 

                const endpoint = `${serverConfig.url}/rest/getMusicDirectory?${auth}&id=${dirId}`;
                const response = await fetch(endpoint, { signal: controller.signal, credentials: 'omit' });
                clearTimeout(timeoutId);

                const data = await response.json();

                if (data['subsonic-response']?.status === 'ok') {
                    const directory = data['subsonic-response'].directory;
                    let children = directory.child || directory.artist || [];

                    let hasSongs = children.some(c => c.streamId || c.duration || c.size || c.title);
                    let hasSubDirs = children.some(c => c.isDir || (!c.streamId && !c.duration && !c.size && !c.title));

                    let currentLevel = 'album';
                    
                    if (hasSongs && !hasSubDirs) {
                        currentLevel = 'song';
                    } else if (hasSubDirs) {
                        let parentState = navigationStack[navigationStack.length - 1];
                        if (parentState && parentState.level === 'artist') {
                            let sampleSubDir = children.find(c => c.isDir || (!c.streamId && !c.duration && !c.size && !c.title));
                            if (sampleSubDir) {
                                currentLevel = 'intermediate';
                            } else {
                                currentLevel = 'album';
                            }
                        } else {
                            currentLevel = 'intermediate';
                        }
                    }

                    children.forEach(c => {
                        const isDir = c.isDir || (!c.streamId && !c.duration && !c.size && !c.title);
                        c._itemType = isDir ? 'album' : 'song';
                    });

                    if (currentLevel === 'song') {
                        children.sort((a, b) => {
                            let discA = parseInt(a.discNumber) || 1;
                            let discB = parseInt(b.discNumber) || 1;
                            if (discA !== discB) return discA - discB;
                            
                            let trackA = parseInt(a.track) || 9999;
                            let trackB = parseInt(b.track) || 9999;
                            if (trackA !== trackB) return trackA - trackB;
                            
                            return (a.title || "").localeCompare(b.title || "");
                        });
                    } else {
                        children.sort((a, b) => (a.name || a.title || "").localeCompare(b.name || b.title || ""));
                    }

                    if (pushToStack) {
                        navigationStack.push({ id: dirId, name: dirName, isIndex: false, level: currentLevel, items: children });
                    }
                    updateBackButtonUI();
                    updateSearchPlaceholder();

                    document.getElementById('section-title').innerText = dirName;
                    document.getElementById('search-input').value = '';
                    currentFolderItems = children;

                    const playAlbumBtn = document.getElementById('btn-play-album');
                    if (currentLevel === 'song' || (!hasSubDirs && hasSongs)) {
                        playAlbumBtn.classList.remove('hidden');
                    } else {
                        playAlbumBtn.classList.add('hidden');
                    }

                    renderFolderContent(children, currentLevel);
                    document.querySelector('main').scrollTop = 0;
                }
            } catch (err) {
                renderServerError();
            }
        }

        async function loadStarredView() {
            navigationStack.push({ isStarred: true, name: "Preferiti", level: 'starred', previousItems: [...currentFolderItems] });
            updateBackButtonUI();
            updateSearchPlaceholder();
            document.getElementById('section-title').innerText = "Preferiti";
            document.getElementById('btn-play-album').classList.add('hidden');
            document.getElementById('search-input').value = '';

            const headerBtnIcon = document.getElementById('btn-header-starred')?.querySelector('i');
            if (headerBtnIcon) headerBtnIcon.className = 'fa-solid fa-star text-lg text-amber-400';

            const grid = document.getElementById('content-grid');
            grid.innerHTML = '<div class="text-gray-500 text-xs text-center py-8"><i class="fa-solid fa-spinner fa-spin mr-1"></i> Caricamento preferiti...</div>';

            try {
                const auth = getSubsonicAuthParams();
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 60000); 

                const endpoint = `${serverConfig.url}/rest/getStarred2?${auth}`;
                const response = await fetch(endpoint, { signal: controller.signal, credentials: 'omit' });
                clearTimeout(timeoutId);

                const data = await response.json();

                if (data['subsonic-response']?.status === 'ok') {
                    const starred = data['subsonic-response'].starred2 || {};
                    const songs = starred.song || [];

                    let allStarredItems = songs.map(s => ({ ...s, type: 'song', _itemType: 'song', title: s.title, starred: true }));

                    currentFolderItems = allStarredItems;
                    renderFolderContent(allStarredItems, 'starred');
                    document.querySelector('main').scrollTop = 0;
                }
            } catch (err) {
                renderServerError();
            }
        }

        async function toggleItemStar(targetItem, event) {
            if (event) event.stopPropagation();
            if (!targetItem || !targetItem.id) return;

            targetItem.starred = !targetItem.starred;

            const searchInput = document.getElementById('search-input');
            const query = searchInput ? searchInput.value : '';
            if (query.trim()) {
                handleSearch(query);
            } else {
                const currentState = navigationStack[navigationStack.length - 1];
                const currentLevel = currentState ? currentState.level : 'artist';
                renderFolderContent(currentFolderItems, currentLevel);
            }

            try {
                const auth = getSubsonicAuthParams();
                const action = targetItem.starred ? 'star' : 'unstar';
                const endpoint = `${serverConfig.url}/rest/${action}?${auth}&id=${encodeURIComponent(targetItem.id)}`;
                const response = await fetch(endpoint, { credentials: 'omit' });
                const data = await response.json();

                if (data['subsonic-response']?.status !== 'ok') {
                    targetItem.starred = !targetItem.starred;
                    if (query.trim()) {
                        handleSearch(query);
                    } else {
                        const currentState = navigationStack[navigationStack.length - 1];
                        const currentLevel = currentState ? currentState.level : 'artist';
                        renderFolderContent(currentFolderItems, currentLevel);
                    }
                } else {
                    const currentState = navigationStack[navigationStack.length - 1];
                    const currentLevel = currentState ? currentState.level : 'artist';
                    if (currentLevel === 'starred' && !targetItem.starred) {
                        loadStarredView();
                    }
                }
            } catch (err) {
                targetItem.starred = !targetItem.starred;
                if (query.trim()) {
                    handleSearch(query);
                } else {
                    const currentState = navigationStack[navigationStack.length - 1];
                    const currentLevel = currentState ? currentState.level : 'artist';
                    renderFolderContent(currentFolderItems, currentLevel);
                }
                console.error("Errore aggiornamento preferito brano:", err);
            }
        }

        function renderFolderContent(items, level) {
            const grid = document.getElementById('content-grid');
            if (!items || items.length === 0) {
                grid.innerHTML = '<div class="text-gray-500 text-xs text-center py-8">Nessun elemento trovato.</div>';
                updateItemsCount(0);
                return;
            }

            let html = '';
            items.forEach((item, index) => {
                const itemName = item.name || item.title || item.album || "Elemento senza nome";
                const itemArtist = item.artist || item.subtitle || "";
                const auth = getSubsonicAuthParams();
                
                const isCurrentlyPlaying = currentPlaylist[currentIndex] && currentPlaylist[currentIndex].id === item.id;
                const isItemDirectory = item.isDir || item.type === 'artist' || item.type === 'album' || (!item.streamId && !item.duration && !item.size && !item.title);

                if (!item._itemType) {
                    if (level === 'artist' || item.type === 'artist') item._itemType = 'artist';
                    else if (isItemDirectory) item._itemType = 'album';
                    else item._itemType = 'song';
                }

                let coverHtml = '';
                if (item.coverArt) {
                    const coverUrl = `${serverConfig.url}/rest/getCoverArt?${auth}&id=${item.coverArt}&size=100`;
                    const fallbackClass = item._itemType === 'artist' ? 'bg-red-950/50 border-red-500/30 text-red-400' : 'bg-amber-950/60 border-amber-500/30 text-amber-400';
                    const fallbackIcon = item._itemType === 'artist' ? 'fa-microphone' : 'fa-folder-open';
                    coverHtml = `<img src="${coverUrl}" class="w-9 h-9 rounded-lg object-cover bg-gray-900 shrink-0 border border-amber-500/20" onerror="this.outerHTML='<div class=\\'w-9 h-9 rounded-lg ${fallbackClass} border flex items-center justify-center shrink-0\\'><i class=\\'fa-solid ${fallbackIcon} text-xs\\'></i></div>'">`;
                } else if (item._itemType === 'artist') {
                    coverHtml = `<div class="w-9 h-9 rounded-lg bg-red-950/50 border border-red-500/30 flex items-center justify-center text-red-400 shrink-0"><i class="fa-solid fa-microphone text-xs"></i></div>`;
                } else {
                    coverHtml = `<div class="w-9 h-9 rounded-lg bg-amber-950/60 border border-amber-500/30 flex items-center justify-center text-amber-400 shrink-0"><i class="fa-solid fa-folder-open text-xs"></i></div>`;
                }
                
                const isSongItem = !isItemDirectory && (item.streamId || item.duration || item.size || item.title || item._itemType === 'song');
                const cardBgClass = isCurrentlyPlaying ? 'playing-card' : 'bg-[#121216] hover:bg-gray-800/80';

                if (level === 'starred') {
                    html += `
                        <div data-song-id="${item.id}" onclick='playSingleTrack(currentFolderItems[${index}], currentFolderItems)' class="${cardBgClass} border border-gray-800 rounded-xl p-2.5 cursor-pointer transition-all duration-200 flex items-center justify-between shadow">
                            <div class="flex items-center space-x-3 truncate">
                                ${coverHtml}
                                <div class="truncate">
                                    <h4 class="font-bold text-xs ${isCurrentlyPlaying ? 'text-red-400 font-extrabold' : 'text-white'} truncate">${itemName}</h4>
                                    <p class="text-[10px] text-gray-400 truncate">${itemArtist}</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-1">
                                <button onclick='toggleItemStar(currentFolderItems[${index}], event)' class="text-amber-400 hover:text-amber-300 p-2 cursor-pointer" title="Preferito">
                                    <i class="fa-solid fa-star text-xs"></i>
                                </button>
                                <i class="fa-solid ${isCurrentlyPlaying ? 'fa-volume-high text-red-400 animate-pulse' : 'fa-play text-red-500'} text-xs px-2"></i>
                            </div>
                        </div>
                    `;
                } else if (isItemDirectory) {
                    html += `
                        <div data-song-id="${item.id}" onclick="loadMusicDirectory('${item.id}', '${itemName.replace(/'/g, "\\'")}')" class="${cardBgClass} border border-gray-800 rounded-xl p-2.5 cursor-pointer transition-all duration-200 flex items-center justify-between shadow">
                            <div class="flex items-center space-x-3 truncate">
                                ${coverHtml}
                                <span class="font-bold text-xs text-white truncate">${itemName}</span>
                            </div>
                            <div class="flex items-center gap-1">
                                <i class="fa-solid fa-chevron-right text-xs text-gray-500 px-2"></i>
                            </div>
                        </div>
                    `;
                } else {
                    html += `
                        <div data-song-id="${item.id}" onclick='playSingleTrack(currentFolderItems[${index}], currentFolderItems)' class="${cardBgClass} border border-gray-800 rounded-xl p-2.5 cursor-pointer transition-all duration-200 flex items-center justify-between shadow">
                            <div class="flex items-center space-x-3 truncate">
                                <div class="w-9 h-9 rounded-lg ${isCurrentlyPlaying ? 'bg-red-600 text-white animate-pulse' : 'bg-red-600/20 text-red-400'} flex items-center justify-center shrink-0">
                                    <i class="fa-solid ${isCurrentlyPlaying ? 'fa-volume-high' : 'fa-music'} text-xs"></i>
                                </div>
                                <div class="truncate">
                                    <h4 class="font-bold text-xs ${isCurrentlyPlaying ? 'text-red-400 font-extrabold' : 'text-white'} truncate">${itemName}</h4>
                                    <p class="text-[10px] text-gray-400 truncate">${itemArtist}</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-1">
                                ${isSongItem ? `<button onclick='toggleItemStar(currentFolderItems[${index}], event)' class="text-amber-400 hover:text-amber-300 p-2 cursor-pointer" title="Preferito"><i class="${item.starred ? 'fa-solid fa-star text-amber-400' : 'fa-regular fa-star text-gray-400'} text-xs"></i></button>` : ''}
                                <i class="fa-solid ${isCurrentlyPlaying ? 'fa-pause' : 'fa-play'} text-xs text-red-500 px-2"></i>
                            </div>
                        </div>
                    `;
                }
            });

            grid.innerHTML = html;
            updateItemsCount(items.length);
        }

        function playCurrentAlbum() {
            if (!currentFolderItems || currentFolderItems.length === 0) return;
            const songList = currentFolderItems.filter(i => !i.isDir && (i.streamId || i.duration || i.size || i.title));
            if (songList.length > 0) {
                playSingleTrack(songList[0], songList);
            }
        }

        function handleSearch(query) {
            const q = query.toLowerCase().trim();
            const currentState = navigationStack[navigationStack.length - 1];
            const currentLevel = currentState ? currentState.level : 'artist';

            if (!q) {
                renderFolderContent(currentFolderItems, currentLevel);
                return;
            }

            const filteredItems = currentFolderItems.filter(item => {
                const name = (item.name || item.title || item.album || "").toLowerCase();
                const artist = (item.artist || "").toLowerCase();
                return name.includes(q) || artist.includes(q);
            });

            renderFolderContent(filteredItems, currentLevel);
        }

        function mapSongToTrack(s, auth) {
            return {
                id: s.id,
                title: s.title || "Brano sconosciuto",
                artist: s.artist || "",
                album: s.album || "",
                genre: s.genre || "N/D",
                year: s.year || "N/D",
                bitRate: s.bitRate ? `${s.bitRate} kbps` : "128 - 320 kbps (VBR/CBR)",
                format: s.suffix ? s.suffix.toUpperCase() : "MP3",
                size: s.size ? `${(s.size / (1024*1024)).toFixed(1)} MB` : "N/D",
                track: parseInt(s.track) || 9999,
                discNumber: parseInt(s.discNumber) || 1,
                starred: s.starred ? true : false,
                coverArt: s.coverArt ? `${serverConfig.url}/rest/getCoverArt?${auth}&id=${s.coverArt}&size=300` : '',
                url: `${serverConfig.url}/rest/stream?${auth}&id=${s.id}`
            };
        }

        function playSingleTrack(song, allItems = []) {
            const auth = getSubsonicAuthParams();
            let trackList = allItems.filter(i => !i.isDir && (i.streamId || i.duration || i.size || i.title));
            
            trackList.sort((a, b) => {
                let discA = parseInt(a.discNumber) || 1;
                let discB = parseInt(b.discNumber) || 1;
                if (discA !== discB) return discA - discB;
                
                let trackA = parseInt(a.track) || 9999;
                let trackB = parseInt(b.track) || 9999;
                if (trackA !== trackB) return trackA - trackB;
                
                return (a.title || "").localeCompare(b.title || "");
            });

            if (trackList.length > 0) {
                originalPlaylist = trackList.map(s => mapSongToTrack(s, auth));
            } else {
                originalPlaylist = [mapSongToTrack(song, auth)];
            }

            currentPlaylist = [...originalPlaylist];
            if (isShuffleActive) applyShuffle();

            let targetIndex = currentPlaylist.findIndex(t => t.id === song.id);
            playTrack(targetIndex !== -1 ? targetIndex : 0);
        }

        async function playTrack(index) {
            if (index < 0 || index >= currentPlaylist.length) return;
            currentIndex = index;
            const track = currentPlaylist[currentIndex];

            document.querySelectorAll('[data-song-id]').forEach(el => {
                el.classList.remove('playing-card');
                const iconContainer = el.querySelector('.w-9');
                const icon = el.querySelector('.w-9 i');
                const title = el.querySelector('h4');

                if (iconContainer) iconContainer.className = 'w-9 h-9 rounded-lg bg-red-600/20 text-red-400 flex items-center justify-center shrink-0';
                if (icon) icon.className = 'fa-solid fa-music text-xs';
                if (title) title.className = 'font-bold text-xs text-white truncate';
            });

            const activeEl = document.querySelector(`[data-song-id="${track.id}"]`);
            if (activeEl) {
                activeEl.classList.add('playing-card');
                const iconContainer = activeEl.querySelector('.w-9');
                const icon = activeEl.querySelector('.w-9 i');
                const title = activeEl.querySelector('h4');

                if (iconContainer) iconContainer.className = 'w-9 h-9 rounded-lg bg-red-600 text-white flex items-center justify-center shrink-0 animate-pulse';
                if (icon) icon.className = 'fa-solid fa-volume-high text-xs';
                if (title) title.className = 'font-bold text-xs text-red-400 font-extrabold truncate';
            }

            updatePlayButtons(false, true);

            try {
                let blob;
                if (blobCache.has(track.id)) {
                    blob = blobCache.get(track.id);
                    blobCache.delete(track.id);
                } else {
                    const response = await fetch(track.url, { credentials: 'omit' });
                    if (!response.ok) throw new Error("Errore stream");
                    blob = await response.blob();
                }

                if (currentPlaylist[currentIndex]?.id !== track.id) return;

                if (currentBlobUrl) {
                    URL.revokeObjectURL(currentBlobUrl);
                }
                currentBlobUrl = URL.createObjectURL(blob);
                audioElement.src = currentBlobUrl;
                audioElement.play();
            } catch (err) {
                console.error("Fallback stream diretto:", err);
                audioElement.src = track.url;
                audioElement.play();
            }

            // Avvia il prefetch in background della traccia successiva
            prefetchNextTrack();

            sendPlayerUpdate('playing', track.id, 0);

            sendScrobble(track.id, false);
            if (scrobbleTimer) clearTimeout(scrobbleTimer);

            const scrobbleDelay = Math.min(30000, (audioElement.duration * 1000) / 2 || 30000);
            scrobbleTimer = setTimeout(() => {
                sendScrobble(track.id, true);
            }, isNaN(scrobbleDelay) || scrobbleDelay < 5000 ? 30000 : scrobbleDelay);

            document.getElementById('mini-player').classList.remove('hidden');
            document.getElementById('mini-title').innerText = track.title;
            document.getElementById('mini-artist').innerText = track.artist;
            document.getElementById('mini-cover').src = track.coverArt || 'pwa/spotifuck_bckgnd_w.png';

            document.getElementById('full-title').innerText = track.title;
            document.getElementById('full-artist').innerText = track.artist;
            document.getElementById('full-album-name').innerText = track.album || '';
            document.getElementById('full-cover').src = track.coverArt || 'pwa/spotifuck_bckgnd_w.png';

            updateStarButtonUI(track.starred);

            if (showLyricsMode) fetchLyricsForCurrentTrack();
            if (showMetaMode) populateTrackMeta();

            updatePlayButtons(true);
            setupMediaSession(track);
        }

        async function toggleCurrentTrackStar() {
            const track = currentPlaylist[currentIndex];
            if (!track) return;

            try {
                const auth = getSubsonicAuthParams();
                const action = track.starred ? 'unstar' : 'star';
                const endpoint = `${serverConfig.url}/rest/${action}?${auth}&id=${track.id}`;
                
                const response = await fetch(endpoint, { credentials: 'omit' });
                const data = await response.json();

                if (data['subsonic-response']?.status === 'ok') {
                    track.starred = !track.starred;
                    updateStarButtonUI(track.starred);
                }
            } catch (err) {
                console.error("Errore aggiornamento preferito:", err);
            }
