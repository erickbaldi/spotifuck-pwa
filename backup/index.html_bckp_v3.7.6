        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        /* Stile Evidenziato Traccia in Riproduzione */
        .playing-card {
            background: linear-gradient(135deg, rgba(185, 28, 28, 0.25) 0%, rgba(18, 18, 22, 0.95) 100%) !important;
            border-color: rgba(239, 68, 68, 0.7) !important;
            box-shadow: 0 0 12px rgba(239, 68, 68, 0.35);
            transform: scale(1.01);
        }

        /* Splash Screen Animation Lampeggiante Rapida */
        @keyframes fast-pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.35; transform: scale(0.95); }
        }
        .animate-fast-pulse {
            animation: fast-pulse 0.8s infinite ease-in-out;
        }

        /* Animazione Progress Bar Splash */
        @keyframes loading-progress {
            0% { width: 10%; }
            50% { width: 75%; }
            100% { width: 95%; }
        }
        .animate-progress-bar {
            animation: loading-progress 1.8s infinite ease-in-out;
        }

        #pwa-splash {
            transition: opacity 0.5s ease, visibility 0.5s ease;
        }
        #pwa-splash.fade-out {
            opacity: 0;
            visibility: hidden;
        }

        /* Modal Installazione PWA Animation */
        #pwa-install-modal {
            transition: opacity 0.3s ease, visibility 0.3s ease;
        }
        #pwa-install-modal.hidden {
            display: none !important;
        }
    </style>
</head>
