    <!-- Icone PWA / Favicon -->
    <link rel="icon" type="image/png" href="pwa/spotifuck_logo_mini.png">
    <link rel="apple-touch-icon" href="pwa/spotifuck_logo_mini.png">
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- CryptoJS per token MD5 Subsonic -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.1/crypto-js.min.js"></script>
    <style>
        body { background-color: #0a0a0c; color: #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        /* Stile Evidenziato Traccia in Riproduzione */
        .playing-card {
            background: linear-gradient(135deg, rgba(185, 28, 28, 0.25) 0%, rgba(18, 18, 22, 0.95) 100%) !important;
            border-color: rgba(239, 68, 68, 0.7) !important;
            box-shadow: 0 0 12px rgba(239, 68, 68, 0.35);
            transform: scale(1.01);
        }

        /* Splash Screen Animation Lampeggiante Rapida */
        @keyframes fast-pulse {
