                    <div><span class="text-gray-500 block text-[10px]">ANNO</span> <span class="font-semibold text-white">${track.year}</span></div>
                    <div><span class="text-gray-500 block text-[10px]">ALBUM</span> <span class="font-semibold text-white truncate block">${track.album}</span></div>
                    <div><span class="text-gray-500 block text-[10px]">FORMATO</span> <span class="font-semibold text-white">${track.format}</span></div>
