        function goBackFolder() {
            const currentState = navigationStack[navigationStack.length - 1];
            const headerBtnIcon = document.getElementById('btn-header-starred')?.querySelector('i');

            if (currentState && currentState.isStarred) {
                navigationStack.pop();
                if (headerBtnIcon) headerBtnIcon.className = 'fa-solid fa-star text-lg text-gray-400 hover:text-amber-400';
                
                currentFolderItems = currentState.previousItems || cachedArtistsItems || [];
                const prevState = navigationStack[navigationStack.length - 1] || { name: "Libreria Musicale", level: 'artist' };
                document.getElementById('section-title').innerText = prevState.name || "Libreria Musicale";
                updateBackButtonUI();
                updateSearchPlaceholder();
                document.getElementById('search-input').value = '';
                
                const playAlbumBtn = document.getElementById('btn-play-album');
                if (prevState.level === 'song') {
                    playAlbumBtn.classList.remove('hidden');
                } else {
                    playAlbumBtn.classList.add('hidden');
                }

                renderFolderContent(currentFolderItems, prevState.level);
                document.querySelector('main').scrollTop = 0;
                return;
            }

            if (navigationStack.length > 1) {
                navigationStack.pop(); 
                const previousState = navigationStack[navigationStack.length - 1]; 
                
                document.getElementById('search-input').value = '';

                if (previousState.isIndex) {
                    navigationStack.pop();
                    loadFolderIndexes(previousState.id, previousState.name);
                } else if (previousState.items) {
                    currentFolderItems = previousState.items;
                    document.getElementById('section-title').innerText = previousState.name;
                    updateBackButtonUI();
                    updateSearchPlaceholder();
                    
                    const playAlbumBtn = document.getElementById('btn-play-album');
                    if (previousState.level === 'song') {
                        playAlbumBtn.classList.remove('hidden');
                    } else {
                        playAlbumBtn.classList.add('hidden');
                    }

                    renderFolderContent(previousState.items, previousState.level);
                    document.querySelector('main').scrollTop = 0;
                } else {
                    executeLoadDirectory(previousState.id, previousState.name, false);
                }
                updateSearchPlaceholder();
            } else {
                loadMusicFolders();
            }
        }

        function toggleStarredMode() {
