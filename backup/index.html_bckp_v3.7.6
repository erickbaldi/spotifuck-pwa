        function clearQueue() {
            sendPlayerUpdate('stopped', '', 0);
            audioElement.pause();
            audioElement.src = "";
            if (currentBlobUrl) {
                URL.revokeObjectURL(currentBlobUrl);
                currentBlobUrl = null;
            }
            audioElement.load();
            currentPlaylist = [];
            originalPlaylist = [];
            currentIndex = 0;
            if (scrobbleTimer) clearTimeout(scrobbleTimer);
