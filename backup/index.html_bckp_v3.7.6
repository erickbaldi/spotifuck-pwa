                    <h4 class="font-bold text-sm text-red-400">Impossibile Connettersi al Server</h4>
                    <p class="text-xs text-gray-300 leading-relaxed">${message}</p>
                    <button onclick="loadMusicFolders()" class="mt-2 bg-red-600 hover:bg-red-500 text-white text-xs font-semibold px-4 py-2 rounded-xl transition shadow cursor-pointer">
                        <i class="fa-solid fa-rotate mr-1"></i> Riprova Connessione
                    </button>
                </div>
            `;
            updateItemsCount(0);
