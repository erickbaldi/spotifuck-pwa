        async function fetchLyricsForCurrentTrack() {
            const track = currentPlaylist[currentIndex];
            const lyricsEl = document.getElementById('lyrics-text');
            lyricsEl.innerText = "Ricerca testo in corso...";

            if (!track || !track.title) {
                lyricsEl.innerText = "Nessun brano in riproduzione.";
                return;
            }

            try {
                const auth = getSubsonicAuthParams();
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 60000);
                
                const endpoint = `${serverConfig.url}/rest/getLyrics?${auth}&artist=${encodeURIComponent(track.artist)}&title=${encodeURIComponent(track.title)}`;
                const response = await fetch(endpoint, { signal: controller.signal, credentials: 'omit' });
                clearTimeout(timeoutId);

                const data = await response.json();

                if (data['subsonic-response'].status === 'ok' && data['subsonic-response'].lyrics) {
                    lyricsEl.innerText = data['subsonic-response'].lyrics.value || "Testo non disponibile.";
                } else {
                    lyricsEl.innerText = "Nessun testo trovato sul server.";
                }
            } catch (err) {
                lyricsEl.innerText = "Impossibile caricare il testo (Server offline o risposta lenta).";
            }
        }

        function getSubsonicAuthParams() {
            const salt = Math.random().toString(36).substring(2, 10);
            const token = CryptoJS.MD5(serverConfig.pass + salt).toString();
            return `u=${encodeURIComponent(serverConfig.user)}&t=${token}&s=${salt}&v=1.16.1&c=spotiFUCK-PWA&playerId=spotifuck-pwa-player&f=json`;
        }

        async function sendPlayerUpdate(status = 'playing', trackId = '', time = 0) {
            if (!serverConfig.user || !serverConfig.pass) return;
            try {
                const auth = getSubsonicAuthParams();
                let params = `${auth}&playerId=spotifuck-pwa-player&playerName=${encodeURIComponent('spotiFUCK PWA Client')}`;
                if (trackId) params += `&songId=${encodeURIComponent(trackId)}`;
                if (time >= 0) params += `&time=${Math.floor(time)}`;
                
                const endpoint = `${serverConfig.url}/rest/updatePlayer?${params}`;
                await fetch(endpoint, { credentials: 'omit' });
            } catch (err) {
                console.error("Errore aggiornamento stato player server:", err);
            }
        }

        async function sendScrobble(trackId, submission = false) {
            if (!serverConfig.user || !serverConfig.pass || !trackId) return;
            try {
                const auth = getSubsonicAuthParams();
                const endpoint = `${serverConfig.url}/rest/scrobble?${auth}&id=${trackId}&submission=${submission}`;
                await fetch(endpoint, { credentials: 'omit' });
            } catch (err) {
                console.error("Errore invio scrobble:", err);
            }
        }

